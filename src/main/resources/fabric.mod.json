{
  "schemaVersion": 1,
  "id": "teamlocator",
  "version": "${version}",
  "name": "TeamLocator",
  "description": "Team communication for PvP: share your coordinates with trusted players, see teammates on a HUD, and ping your team when you're under attack.",
  "authors": [
    "spogdev"
  ],
  "license": "MIT",
  "icon": "assets/teamlocator/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.spog.teamlocator.client.TeamLocatorClient"
    ],
    "modmenu": [
      "dev.spog.teamlocator.client.gui.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19",
    "fabric-api": "*",
    "minecraft": ">=26.1"
  },
  "suggests": {
    "modmenu": "*"
  }
}
