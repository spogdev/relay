{
  "schemaVersion": 1,
  "id": "relay",
  "version": "${version}",
  "name": "Relay",
  "description": "A team communications mod easily allowing teams to locate each other and view other stats about their team in combat.",
  "authors": [
    "Spog"
  ],
  "license": "MIT",
  "icon": "assets/relay/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.spog.teamlocator.client.TeamLocatorClient"
    ],
    "modmenu": [
      "dev.spog.teamlocator.client.gui.ModMenuIntegration"
    ]
  },
  "mixins": [
    "relay.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19",
    "fabric-api": "*",
    "minecraft": "~1.21.11",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*",
    "xaerominimap": "*",
    "xaeroworldmap": "*"
  }
}
